{
  "manifest_version": 3,
  "name": "ととのえ｜Totonoe",
  "version": "0.1.0",
  "description": "選択した日付を、自分で決めた書式に右クリックひとつで整えます。「6/5」→「6月5日(金)」。",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ととのえ｜Totonoe の書式を編集"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
